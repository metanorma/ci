source "https://rubygems.org"

# lutaml-lml >= 0.1.2 accepts namespace-qualified types (xsd:date) and
# ships the lutaml-lml executable the Makefile invokes.
# lutaml 0.10.x provides the lutaml-wsd2uml executable (dropped in 0.11);
# pinned alongside lutaml-lml, which renders the .lutaml views.
gem "lutaml", "~> 0.10.0"
gem "lutaml-lml", ">= 0.1.2"
# lutaml-xsd: required by the iso/ LXR grammar-package build (deploy.yml);
# the pre-consolidation metanorma-model-iso Gemfile carried it and the
# template sync dropped it, breaking that job.
gem "lutaml-xsd"